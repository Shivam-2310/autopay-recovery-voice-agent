# ── LiveKit Cloud ──────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Outbound Telephony & SIP ──────────────────────────────────
SIP_TRUNK_ID=
TWILIO_PHONE_NUMBER=
LIVEKIT_AGENT_NAME=autopay-recovery
COMPANY_NAME=PayEase

# ── LLM (plug-and-play) ──────────────────────────────────────
# Provider: groq | gemini | deepseek | openai_compatible
LLM_PROVIDER=groq
# LLM_MODEL=               # optional override (provider default used if blank)
# LLM_BASE_URL=             # required only for openai_compatible

# Provider-specific API keys (set the one matching your provider)
GROQ_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_API_KEY=              # generic fallback / openai_compatible key

# Comma-separated fallback providers tried on error (e.g. deepseek,gemini)
# LLM_FALLBACKS=

# ── STT / TTS & Audio Quality ────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
ELEVENLABS_API_KEY=
ELEVEN_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
ELEVENLABS_ENCODING=pcm_24000
ELEVENLABS_STABILITY=0.75
ELEVENLABS_SIMILARITY=0.85
