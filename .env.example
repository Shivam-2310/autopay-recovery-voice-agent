# ── Safety & Phone Destination Lock ──────────────────────────
# All outbound calls and SMS route ONLY to this number (strict E.164 format):
DEMO_PHONE=+919876543210
# Set to 'true' to bypass the 09:00 - 20:00 IST call window and 1-attempt/day limits:
DEMO_OVERRIDE=true

# ── Outbound Telephony (Twilio & LiveKit SIP) ─────────────────
# Verified Twilio phone number used as outbound caller ID:
TWILIO_NUMBER=+14155550199
# LiveKit outbound SIP trunk ID (Twilio-backed):
SIP_TRUNK_ID=ST_your_sip_trunk_id
LIVEKIT_AGENT_NAME=autopay-recovery
COMPANY_NAME=PayEase

# ── LiveKit Cloud ──────────────────────────────────────────────
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM (Plug-and-Play) ────────────────────────────────────────
# Provider: groq | gemini | deepseek | openai_compatible
LLM_PROVIDER=groq
# LLM_MODEL=               # optional override (provider default used if blank)
# LLM_BASE_URL=             # required only for openai_compatible

# Provider-specific API keys (set the one matching your chosen provider)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_API_KEY=              # generic fallback / openai_compatible key
# LLM_FALLBACKS=deepseek,gemini

# ── Speech-to-Text (Deepgram) ──────────────────────────────────
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_MODEL=nova-3

# ── Text-to-Speech (ElevenLabs) ────────────────────────────────
ELEVEN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVEN_VOICE_ID=TX3LPaxmHKxFdv7VOQHJ
ELEVEN_MODEL=eleven_turbo_v2_5
ELEVEN_STABILITY=0.50
ELEVEN_SIMILARITY=0.75
ELEVEN_STYLE=0.0
ELEVEN_SPEED=1.0

# ── Internal Service Communication ─────────────────────────────
INTERNAL_SECRET=secret_internal_token_change_me

# ── SMS Dispatch & Compliance (Twilio) ─────────────────────────
# SMS_MODE: 'mock' (simulated, no network/carrier costs) or 'twilio' (real SMS)
SMS_MODE=mock
# Clean SMS template complying with carrier & Indian DLT spam filtering:
# Strictly avoids 'loan', 'recovery', 'debt', or 'overdue' keywords.
# Placeholders: {first_name}, {amount}, {pay_url}
SMS_BODY_TEMPLATE=Hi {first_name}, here is your secure link from PayEase: {pay_url}
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUBLIC_BASE_URL: ngrok/cloudflared tunnel URL to receive Twilio status callbacks and allow physical clicks
# PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

